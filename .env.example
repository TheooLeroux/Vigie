# Origine exacte utilisée pour accéder au plateau
BETTER_AUTH_URL=http://127.0.0.1:3001
# Générer avec : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Client OAuth Google Cloud de type « Application Web »
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Liste fermée, séparée par des virgules. Aucune autorisation implicite de tout le domaine.
VIGIE_ALLOWED_GOOGLE_EMAILS=theo.leroux@reborn-france.com,contact@reborn-france.com
# Clé de chiffrement indépendante pour les secrets des hébergeurs : 32 octets en hexadécimal.
VIGIE_CONNECTOR_ENCRYPTION_KEY=
# PostgreSQL Neon : URL poolée avec TLS. Obligatoire en production.
DATABASE_URL=
# Neon Realtime : variables exclusivement serveur (jamais NEXT_PUBLIC_).
# Activer Realtime sur la branche et autoriser l’origine BETTER_AUTH_URL.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
VIGIE_UPDATES_ENABLED=0
VIGIE_UPDATES_RUNNER_REPOSITORY=TheooLeroux/Vigie
VIGIE_UPDATES_RUNNER_REF=main
# Secret serveur que Vercel transmet aux appels de la tâche de surveillance.
CRON_SECRET=
# Sonde facultative en production : équipe Vercel et jeton dédié côté serveur, avec accès en lecture aux projets.
VIGIE_VERCEL_PILOT_TEAM_ID=
VIGIE_VERCEL_PILOT_TOKEN=
VIGIE_UPDATES_REPOSITORIES=
VIGIE_UPDATES_GITHUB_TOKENS={}
VIGIE_UPDATES_GITHUB_TOKEN_JANSSEN76140=
# Contrôle WordPress gratuit via WPVulnerability : aucun jeton nécessaire.
# Activer uniquement après validation du pilote WordPress sans SSH sur copie.
VIGIE_WORDPRESS_AGENT_PRODUCTION_ENABLED=0
# Backup : chemin absolu privé, partagé par Vigie et son exécuteur.
VIGIE_BACKUP_DIRECTORY=
# Stockage objet privé. Fournir un jeton lecture seule à Vigie et un jeton lecture/écriture au worker.
VIGIE_BACKUP_S3_ENDPOINT=
VIGIE_BACKUP_S3_BUCKET=
VIGIE_BACKUP_S3_REGION=auto
VIGIE_BACKUP_S3_KEY_ID=
VIGIE_BACKUP_S3_SECRET=
# Espace de travail privé du worker, sur un volume chiffré pour les données de production.
VIGIE_BACKUP_SCRATCH_DIRECTORY=
# Accès PostgreSQL en lecture à l’inventaire, partagé par les jobs de sauvegarde automatique.
VIGIE_BACKUP_INVENTORY_DATABASE_URL=
# Application GitHub installée sur les dépôts à sauvegarder, permission Contents en lecture.
VIGIE_BACKUP_GITHUB_APP_ID=
VIGIE_BACKUP_GITHUB_APP_KEY=
# Clé publique de l’hôte SSH Railway, confirmée avant son ajout au worker.
VIGIE_BACKUP_RAILWAY_KNOWN_HOST=
# Fichier OpenSSH facultatif utilisé uniquement par le worker.
VIGIE_BACKUP_SSH_CONFIG=
