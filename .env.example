# Origine exacte utilisée pour accéder au plateau
BETTER_AUTH_URL=http://127.0.0.1:3001
# Générer avec : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Client OAuth Google Cloud de type « Application Web »
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Liste fermée, séparée par des virgules. Aucune autorisation implicite de tout le domaine.
VIGIE_ALLOWED_GOOGLE_EMAILS=theo.leroux@reborn-france.com,contact@reborn-france.com
# Clé de chiffrement indépendante pour les secrets des hébergeurs : 32 octets en hexadécimal.
VIGIE_CONNECTOR_ENCRYPTION_KEY=
# PostgreSQL Neon : URL poolée avec TLS. Obligatoire en production.
DATABASE_URL=
