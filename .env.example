# Origine exacte utilisée pour accéder au plateau
BETTER_AUTH_URL=http://127.0.0.1:3001
# Générer avec : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Client OAuth Google Cloud de type « Application Web »
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Liste fermée, séparée par des virgules. Aucune autorisation implicite de tout le domaine.
VIGIE_ALLOWED_GOOGLE_EMAILS=theo.leroux@reborn-france.com,contact@reborn-france.com
# Clé de chiffrement indépendante pour les secrets des hébergeurs : 32 octets en hexadécimal.
VIGIE_CONNECTOR_ENCRYPTION_KEY=
# PostgreSQL Neon : URL poolée avec TLS. Obligatoire en production.
DATABASE_URL=
# Maintenance : accès GitHub dédié, pas les jetons Vercel/Railway.
VIGIE_MAINTENANCE_GITHUB_TOKEN=
# Facultatif : JSON de jetons distincts par propriétaire ou dépôt, pour les parcs multi-comptes.
VIGIE_MAINTENANCE_GITHUB_TOKENS={}
# Liste explicite, séparée par des virgules, des seuls dépôts autorisés.
VIGIE_MAINTENANCE_REPOSITORIES=
# Dépôt de confiance contenant .github/workflows/vigie-maintenance.yml et le worker.
VIGIE_MAINTENANCE_RUNNER_REPOSITORY=
VIGIE_MAINTENANCE_RUNNER_REF=main
# La création de PR n'implique pas une autorisation de fusion.
VIGIE_MAINTENANCE_ALLOW_MERGE=false
# Contrôles CI exigés par dépôt ; absence = fusion depuis Vigie bloquée.
VIGIE_MAINTENANCE_REQUIRED_CHECKS={}
