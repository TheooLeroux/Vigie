{
  "name": "vigie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-postgres.ts",
    "db:import-sqlite": "tsx --env-file-if-exists=.env.local scripts/import-sqlite-to-postgres.ts",
    "backups:tick": "tsx --env-file-if-exists=.env.local scripts/backup-worker.ts",
    "backups:plan": "tsx --env-file-if-exists=.env.local scripts/plan-platform-backups.ts",
    "backups:discover": "tsx --env-file-if-exists=.env.local scripts/discover-platform-backups.ts"
  },
  "engines": {
    "node": "24.22.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/lib-storage": "3.1165.0",
    "@aws-sdk/s3-request-presigner": "3.1165.0",
    "@neon/realtime": "0.2.1",
    "better-auth": "1.7.19",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
