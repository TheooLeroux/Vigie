  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@neon/realtime": "0.1.2",
    "better-auth": "1.7.14",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
